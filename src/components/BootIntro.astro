<div id="boot-overlay" class="overlay">
	<pre id="boot-text" class="boot-text"></pre>
	<button id="skip-btn" class="skip" type="button">skip &gt;</button>
</div>

<style>
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 9999;
		background: var(--bg);
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 20vh;
		opacity: 1;
		transition: opacity 0.8s ease;
	}

	.overlay.hide {
		opacity: 0;
		pointer-events: none;
	}

	.boot-text {
		margin: 0;
		padding: 24px;
		width: 100%;
		max-width: 640px;
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1.8;
		color: var(--accent);
		white-space: pre-wrap;
	}

	.skip {
		position: fixed;
		right: 24px;
		bottom: 24px;
		padding: 8px 16px;
		background: transparent;
		border: 1px solid var(--accent);
		color: var(--accent);
		font-family: var(--font-mono);
		cursor: pointer;
	}

	.skip:hover {
		background: var(--accent);
		color: var(--bg);
	}
</style>

<script>
	const lines = [
		"> booting Futurestack Intelligence.dev ...",
        "> initializing modules ...",
		"> loading founder information ...",
		"> access granted.",
	];

	const overlay = document.getElementById("boot-overlay") as HTMLElement;
	const textEl = document.getElementById("boot-text") as HTMLElement;
	const skipBtn = document.getElementById("skip-btn") as HTMLElement;

	let skipped = false;
	let finished = false;

	const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

	function alreadySeen() {
		try {
			return sessionStorage.getItem("bootSeen") === "1";
		} catch {
			return false;
		}
	}

	function finish() {
		if (finished) return;
		finished = true;
		try {
			sessionStorage.setItem("bootSeen", "1");
		} catch {}
		overlay.classList.add("hide");
		setTimeout(() => overlay.remove(), 800);
	}

	async function typeLine(line) {
		for (const char of line) {
			if (skipped) return;
			textEl.textContent += char;
			await delay(100);
		}
		textEl.textContent += "\n";
		await delay(300);
	}

	async function runBoot() {
		for (const line of lines) {
			if (skipped) return;
			await typeLine(line);
		}
		await delay(600);
		finish();
	}

	skipBtn.addEventListener("click", () => {
		skipped = true;
		finish();
	});

	if (alreadySeen()) {
		overlay.remove();
	} else {
		runBoot();
	}
</script>