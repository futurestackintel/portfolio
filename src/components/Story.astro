---
// Paste your YouTube video ID here when the video is ready.
// For https://www.youtube.com/watch?v=abc123XYZ the ID is: abc123XYZ
// While this is empty, the video window is hidden and only the text shows.
const videoId = '';

const embedUrl = videoId
	? `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&rel=0&playsinline=1`
	: '';
---

<section id="story" class="story">
	<h2><span class="hash">#</span> story</h2>
	<p class="intro">
		I studied Adult Education at the University of Ilorin, then taught myself web development
		and cybersecurity by building things. I'm most interested in where AI, security and
		education meet, and I publish what I learn along the way.
	</p>
	<p class="quote">Ideas should not remain ideas. They should become products, systems and opportunities.</p>

	{videoId && (
		<div class="window">
			<div class="window-bar">
				<span class="dot"></span>
				<span class="dot"></span>
				<span class="dot"></span>
				<span class="window-title">story.mp4</span>
			</div>
			<iframe
				id="story-frame"
				class="frame"
				data-src={embedUrl}
				title="My story"
				allow="autoplay; encrypted-media; picture-in-picture"
				allowfullscreen
			></iframe>
		</div>
	)}
</section>

<style>
	.story {
		max-width: 900px;
		margin: 0 auto;
		padding: 80px 24px;
		scroll-margin-top: 70px;
	}

	h2 {
		margin: 0 0 16px;
		font-family: var(--font-mono);
		font-size: 1.5rem;
	}

	.hash {
		color: var(--accent);
	}

	.intro {
		margin: 0 0 20px;
		max-width: 620px;
		color: var(--text);
		font-size: 1.05rem;
	}

	.quote {
		margin: 0 0 32px;
		padding-left: 16px;
		max-width: 560px;
		border-left: 2px solid var(--accent);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	.window {
		border: 1px solid var(--border);
		background: var(--bg-panel);
	}

	.window-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--text-dim);
	}

	.window-title {
		margin-left: 8px;
		color: var(--text-dim);
	}

	.frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}
</style>

<script>
	// The video URL sits in data-src, so nothing loads until the visitor
	// actually scrolls to it. Then we copy it into src and it starts (muted).
	const frame = document.getElementById("story-frame") as HTMLIFrameElement | null;

	if (frame) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						frame.src = frame.dataset.src ?? "";
						observer.unobserve(frame);
					}
				}
			},
			{ threshold: 0.5 }
		);

		observer.observe(frame);
	}
</script>
