---
import Layout from './Layout.astro';

// Astro passes the article's header (title, date, summary) in as "frontmatter"
const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | Dahood`} description={frontmatter.summary}>
	<article class="post">
		<a href="/#thoughts" class="back">&lt; back to notes</a>
		<h1>{frontmatter.title}</h1>
		<p class="date">{frontmatter.date}</p>
		<div class="body">
			<slot />
		</div>
	</article>
</Layout>

<style>
	.post {
		max-width: 700px;
		margin: 0 auto;
		padding: 60px 24px 40px;
	}

	.back {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--accent);
		text-decoration: none;
	}

	h1 {
		margin: 24px 0 8px;
		font-size: clamp(1.8rem, 5vw, 2.8rem);
		line-height: 1.15;
	}

	.date {
		margin: 0 0 40px;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-dim);
	}

	/* Markdown content arrives from outside this file, so scoped styles can't
	   reach it. :global() lifts that limit for just the part inside the brackets. */
	.body :global(h2) {
		margin: 40px 0 12px;
		font-family: var(--font-mono);
		font-size: 1.25rem;
		color: var(--accent);
	}

	.body :global(p),
	.body :global(li) {
		color: var(--text);
	}

	.body :global(a) {
		color: var(--accent);
	}

	.body :global(code) {
		padding: 2px 6px;
		background: var(--bg-panel);
		border: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
</style>
